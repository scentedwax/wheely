#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<WheelScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20), dp(26), dp(20), dp(22)
        spacing: dp(14)

        Label:
            text: 'W H E E L Y'
            font_size: '13sp'
            bold: True
            color: 1, 0.62, 0.4, 0.9
            size_hint_y: None
            height: dp(22)

        GlassCard:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(118)
            padding: dp(16), dp(12)
            spacing: dp(2)

            Label:
                text: root.caption_text
                font_size: '11sp'
                bold: True
                color: 1, 0.62, 0.4, 0.95
                size_hint_y: None
                height: dp(18)

            Label:
                text: root.result_text
                font_size: root.result_fs
                bold: True
                color: 1, 0.97, 0.93, 1
                opacity: root.result_opacity
                halign: 'center'
                valign: 'middle'
                text_size: self.width, self.height

        WheelWidget:
            id: wheel
            angle: root.angle

        PillButton:
            style: 'primary'
            text: root.spin_label
            font_size: '19sp'
            bold: True
            size_hint_y: None
            height: dp(58)
            on_release: root.spin()
